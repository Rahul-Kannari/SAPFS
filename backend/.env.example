# Application
APP_NAME=Smart Academic Performance Forecasting System
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://sapfs_user:sapfs_pass@localhost:5432/sapfs_db
DATABASE_SYNC_URL=postgresql://sapfs_user:sapfs_pass@localhost:5432/sapfs_db

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=change-this-super-secret-key-in-production-use-openssl-rand
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-use-openssl-rand
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@sapfs.edu

# ML
ML_MODELS_DIR=./ml_models
MODEL_VERSION=v1.0

# File Storage
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
